        <mxCell id="sys_player" value="Player System  &lt;span style=&quot;font-weight:normal;font-size:11px;color:#666&quot;&gt;Smoking.Player&lt;/span&gt;" style="swimlane;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;fontSize=16;fontStyle=1;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="700" height="712" as="geometry"/></mxCell>
        <mxCell id="PathWalker" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;PathWalker&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;MonoBehaviour · on &quot;Player&quot;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;WalkPath path&lt;br&gt;float speed = 1.4&lt;br&gt;EndMode endMode (PingPong / Loop / Stop / WalkOff)&lt;br&gt;float maxStepHeight, maxSlope, probeAhead&lt;br&gt;float retreatDistance&lt;br&gt;bool startWherePlaced (editor)&lt;br&gt;float distance  // along path&lt;br&gt;int direction&lt;br&gt;bool stopped&lt;br&gt;float groundHeight&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;event Action LostGround&lt;br&gt;Vector3 Velocity&lt;br&gt;Start()  → start at checkpoint / path start&lt;br&gt;Update()  → move along path, raycast ground&lt;br&gt;IsWallAhead()  → turn around + retreat&lt;br&gt;TryGround(point, out y)&lt;br&gt;HandlePathEnd()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_player"><mxGeometry x="30" y="70" width="300" height="364" as="geometry"/></mxCell>
        <mxCell id="WalkPath" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;WalkPath&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;MonoBehaviour · child Transforms = waypoints&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;List&amp;lt;Vector3&amp;gt; points&lt;br&gt;float Length&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;Rebuild()&lt;br&gt;Evaluate(distance, out forward)&lt;br&gt;ClosestDistance(point)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_player"><mxGeometry x="30" y="464" width="300" height="169" as="geometry"/></mxCell>
        <mxCell id="FallRestart" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;FallRestart&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;MonoBehaviour · on &quot;Player&quot;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;PathWalker walker&lt;br&gt;Ragdoll ragdoll&lt;br&gt;float restartDelay = 2.5&lt;br&gt;AudioCue fallSound&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;HandleLostGround()&lt;br&gt;RestartAfterDelay()  → reload active scene&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_player"><mxGeometry x="370" y="70" width="300" height="184" as="geometry"/></mxCell>
        <mxCell id="Ragdoll" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Ragdoll&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;MonoBehaviour · on MannequinModel&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;float totalMass&lt;br&gt;List&amp;lt;Rigidbody&amp;gt; bodies&lt;br&gt;List&amp;lt;Collider&amp;gt; colliders&lt;br&gt;bool IsActive&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;Awake()  → Build() joints from Humanoid bones&lt;br&gt;Activate(velocity)&lt;br&gt;SetPhysics(on)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_player"><mxGeometry x="370" y="284" width="300" height="199" as="geometry"/></mxCell>
        <mxCell id="RespawnPoint" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;RespawnPoint&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;static class · survives scene reload&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;static string scene&lt;br&gt;static Vector3 position&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;Set(point)&lt;br&gt;Clear()&lt;br&gt;TryGet(out point)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_player"><mxGeometry x="370" y="513" width="300" height="169" as="geometry"/></mxCell>
        <mxCell id="sys_flow" value="Game Flow / Scene Management  &lt;span style=&quot;font-weight:normal;font-size:11px;color:#666&quot;&gt;Smoking.GameFlow&lt;/span&gt;" style="swimlane;html=1;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;fontSize=16;fontStyle=1;align=left;spacingLeft=14;collapsible=0;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="1040" height="1005" as="geometry"/></mxCell>
        <mxCell id="SceneFlow" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;SceneFlow&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;MonoBehaviour · one per scene&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;AudioCue backgroundMusic, clickSound&lt;br&gt;bool loading&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;StartGame() / StartLevel(index)&lt;br&gt;RestartGame() / MainMenu() / Credits()&lt;br&gt;CompleteGame()  → NextScene&lt;br&gt;Load(scene)  → RespawnPoint.Clear(), LoadSceneAsync&lt;br&gt;Quit()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_flow"><mxGeometry x="30" y="70" width="300" height="214" as="geometry"/></mxCell>
        <mxCell id="GameSettingsService" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;GameSettingsService&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;Singleton · DontDestroyOnLoad&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;static Instance&lt;br&gt;GameSettingsConfig config&lt;br&gt;AudioBootstrap audioRoot&lt;br&gt;float Brightness&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;event Action&amp;lt;float&amp;gt; BrightnessChanged&lt;br&gt;SetBrightness(value)&lt;br&gt;Volume / Music / Sfx  (from AudioBootstrap)&lt;br&gt;Save()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_flow"><mxGeometry x="30" y="314" width="300" height="214" as="geometry"/></mxCell>
        <mxCell id="GameSettingsConfig" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;GameSettingsConfig&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555&quot;&gt;ScriptableObject · GameSettings.asset&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;vars&lt;/span&gt;&lt;br&gt;string mainMenuScene&lt;br&gt;string[] levelScenes&lt;br&gt;string creditsScene&lt;br&gt;string[] levelQuotes, quoteAuthor&lt;br&gt;float minimumBrightness, defaultBrightness&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;span style=&quot;color:#888&quot;&gt;functions / events&lt;/span&gt;&lt;br&gt;SceneAfter(current)&lt;br&gt;QuoteAfter(level)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="sys_flow"><mxGeometry x="30" y="558" width="300" height="199" as="geometry"/></mxCell>
